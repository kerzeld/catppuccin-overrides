{
	"lsp": {
		"eslint": {
			"enable_lsp_tasks": false
		}
	},
	"language_servers": [
		"oxfmt",
		"oxlint",
		"package-version-server",
		"vtsls",
		"color-lsp",
		"json-language-server"
	],
	"languages": {
		"JavaScript": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"TypeScript": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		},
		"JSON": {
			"formatter": {
				"language_server": {
					"name": "oxfmt"
				}
			}
		}
	},
	"lsp_document_colors": "inlay"
}
