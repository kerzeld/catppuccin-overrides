{
	"name": "catppuccin-overrides",
	"version": "1.0.3",
	"description": "Generate Catppuccin-derived theme overrides (Zed, Plasma, GTK, Firefox, Ghostty, oh-my-posh, Noctalia, Kvantum, niri, rmpc, Zen)",
	"keywords": [
		"catppuccin",
		"themes",
		"dotfiles"
	],
	"license": "MIT",
	"author": "kerzeld",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/kerzeld/catppuccin-overrides.git"
	},
	"type": "module",
	"scripts": {
		"generate": "node src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt src"
	},
	"dependencies": {
		"@msgpack/msgpack": "^3.1.2",
		"color": "5.0.2",
		"lzma": "^2.3.2",
		"minimist": "1.2.8",
		"mustache": "4.2.0"
	},
	"devDependencies": {
		"@types/lzma": "^2.3.0",
		"@types/minimist": "1.2.5",
		"@types/mustache": "4.2.6",
		"@types/node": "24.10.0",
		"oxfmt": "0.31.0",
		"oxlint": "1.46.0",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.25.0"
}
